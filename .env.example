# Robtic Ticket. Bun loads .env by itself.
#
# Production keeps only these three in the container and reads everything below from the admin console
# (admin.robtic.org → Discord → Bot settings → Robtic Ticket): see libs/config/src/remote-config.ts.
# ROBTIC_CONFIG_MONGO_URI=
# ROBTIC_CONFIG_KEY=
# ROBTIC_BOT=ticket

# The bot (Discord Developer Portal → your app). Turn on the Message Content and Server Members intents:
# transcripts need every message, permission checks need members.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Development only: slash commands are registered on this server at once. Leave empty in production (global).
DISCORD_GUILD_ID=

# The database. The dashboard (robtic-discord, real mode) must use the same one: it writes `ticketsettings` and
# `panelposts`, and reads `tickets` and `transcripts`.
MONGODB_URI=mongodb://127.0.0.1:27017/robtic-ticket

# Where the transcript page is served (apps/transcript). Links in Discord point to <this>/<id>.
# Leave empty to send only the HTML file. Production: https://robtic.org/discord/transcripts
TRANSCRIPT_BASE_URL=http://localhost:5180/transcript

# Seconds between checks for "post this panel" requests from the dashboard.
PANEL_POLL_SECONDS=5

NODE_ENV=dev
