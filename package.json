{
    "name": "robtic-ticket",
    "workspaces": [
        "apps/*",
        "libs/*"
    ],
    "type": "module",
    "scripts": {
        "dev": "bun run --filter @robo/bot dev",
        "dev:bot": "bun --watch apps/bot/src/bot.ts",
        "dev:transcript": "bun run --filter @robo/transcript-web dev",
        "start": "bun apps/bot/src/bot.ts",
        "build:transcript": "bun run --filter @robo/transcript-web build",
        "typecheck": "tsc -p tsconfig.check.json --pretty false",
        "test": "bun test apps/bot/tests",
        "postinstall": "git config core.hooksPath .githooks"
    },
    "devDependencies": {
        "@types/bun": "1.1.14",
        "@types/node": "^25.9.1",
        "typescript": "^5.7.3"
    },
    "dependencies": {
        "@napi-rs/canvas": "^0.1.82",
        "chalk": "^4.1.2",
        "dotenv": "^17.2.3"
    }
}
